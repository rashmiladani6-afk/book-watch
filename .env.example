# Firebase (push notifications)
VITE_FIREBASE_VAPID_KEY=
VITE_DEFAULT_FCM_TOKEN=

# Supabase (legacy movie booking scaffold)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Generic API base (legacy scaffold)
VITE_API_BASE_URL=

# Garba Town auth
VITE_GARBATOWN_AUTH_BASE_URL=
VITE_GARBATOWN_API_BEARER=

# Guest browse access (events without sign-in on Home / Events list)
# Option A: paste a working user token from Postman login
VITE_GARBATOWN_GUEST_USER_TOKEN=
# Option B: browse account used only for read-only event lists
VITE_GARBATOWN_BROWSE_EMAIL=
VITE_GARBATOWN_BROWSE_PASSWORD=
# When live guest API is unavailable, show sample events (default: enabled)
VITE_GARBATOWN_ALLOW_GUEST_FALLBACK=true

# Garba Town endpoints (optional overrides; defaults use /garba-auth proxy)
VITE_GARBATOWN_POPULAR_EVENTS_URL=
VITE_GARBATOWN_EVENT_DETAILS_URL=
VITE_GARBATOWN_EVENT_LIKE_URL=
VITE_GARBATOWN_ADD_RATING_URL=
VITE_GARBATOWN_ADD_TO_CART_URL=
VITE_GARBATOWN_CART_DETAILS_URL=
VITE_GARBATOWN_REMOVE_CART_URL=
VITE_GARBATOWN_BUY_TICKET_URL=
VITE_GARBATOWN_ORDER_SUMMARY_URL=
VITE_GARBATOWN_MY_TICKETS_URL=
VITE_GARBATOWN_TICKET_DETAILS_URL=
VITE_GARBATOWN_TICKET_DOWNLOAD_URL=
VITE_GARBATOWN_SPLIT_TICKET_URL=
VITE_GARBATOWN_UPDATE_LOCATION_URL=
VITE_GARBATOWN_NEARBY_EVENTS_URL=
VITE_GARBATOWN_PROFILE_URL=
VITE_GARBATOWN_EDIT_PROFILE_URL=
VITE_GARBATOWN_DELETE_ACCOUNT_URL=
VITE_GARBATOWN_CHANGE_PASSWORD_URL=
VITE_GARBATOWN_CONTACT_US_URL=
VITE_GARBATOWN_PAYMENT_GATEWAY_URL=
VITE_GARBATOWN_CREATE_ORDER_URL=
VITE_GARBATOWN_VERIFY_PAYMENT_URL=
